from fastapi.testclient import TestClient

from app.main import app


def test_debug_endpoint_rejects_missing_key(monkeypatch):
    monkeypatch.setenv("SYLVASEARCH_API_KEY", "test-secret")
    response = TestClient(app).get("/debug/index")
    assert response.status_code == 401


def test_debug_endpoint_accepts_correct_key(monkeypatch):
    monkeypatch.setenv("SYLVASEARCH_API_KEY", "test-secret")
    response = TestClient(app).get(
        "/debug/index",
        headers={"X-API-Key": "test-secret"},
    )
    assert response.status_code == 200


def test_protected_endpoint_fails_closed_without_configuration(monkeypatch):
    monkeypatch.delenv("SYLVASEARCH_API_KEY", raising=False)
    response = TestClient(app).get("/debug/index")
    assert response.status_code == 503


def test_search_remains_public(monkeypatch):
    monkeypatch.delenv("SYLVASEARCH_API_KEY", raising=False)
    response = TestClient(app).get("/search", params={"q": "python"})
    assert response.status_code == 200
